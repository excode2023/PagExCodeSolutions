
@* =============================================
   HERO: PRESENTACIÓN PRINCIPAL DE LA EMPRESA
   ============================================= *@

<section class="hero-section"
         aria-labelledby="hero-title">

    @* Fondo decorativo *@
    <div class="hero-overlay"
         aria-hidden="true">
    </div>

    <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                  Class="hero-container">

        <div class="hero-content">

            @* Categorías principales de servicios *@
            <div class="badge-pill">

                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome"
                         Size="Size.Small" />

                <span>
                    Software a medida · Automatización · IA
                </span>

            </div>

            @* =====================================
               SEO: ENCABEZADO PRINCIPAL H1
               ===================================== *@

            <MudText HtmlTag="h1"
                     id="hero-title"
                     Typo="Typo.h1"
                     Class="hero-title">

                Desarrollo de software a medida

                <span class="hero-highlight">
                    y automatización para tu negocio
                </span>

            </MudText>

            @* =====================================
               SEO: DESCRIPCIÓN DE SERVICIOS
               ===================================== *@

            <MudText HtmlTag="p"
                     Typo="Typo.body1"
                     Class="hero-description">

                En Ex-code Solutions desarrollamos páginas web,
                aplicaciones empresariales y MicroApps para
                resolver problemas concretos.

                Automatizamos procesos e integramos
                inteligencia artificial cuando aporta
                valor a tu negocio.

            </MudText>

            @* =====================================
               MARKETING: LLAMADAS A LA ACCIÓN
               ===================================== *@

            <div class="hero-actions">

                @* Recorrido 1: soluciones existentes *@
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           Class="hero-btn"
                           Href="/soluciones">

                    Explorar soluciones

                </MudButton>

                @* Recorrido 2: desarrollo personalizado *@
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           Class="hero-btn hero-btn-outline"
                           Href="/#contact">

                    Solicitar desarrollo personalizado

                </MudButton>

            </div>

        </div>

        @* =====================================
           TARJETAS DECORATIVAS
           ===================================== *@

        <div class="hero-cards"
             aria-hidden="true">

            <div class="floating-card card-ia">

                @* Este contenedor podrá recibir una imagen o un video. *@
                <div class="floating-card-media">
                    <MudIcon Icon="@Icons.Material.Filled.Psychology" />
                </div>

                <span>IA</span>

            </div>

            <div class="floating-card card-chatbot">

                <div class="floating-card-media">
                    <MudIcon Icon="@Icons.Material.Filled.Chat" />
                </div>

                <span>Chatbot WhatsApp</span>

            </div>

            <div class="floating-card card-citas">

                <div class="floating-card-media">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                </div>

                <span>Citas</span>

            </div>

            <div class="floating-card card-logistica">

                <div class="floating-card-media">
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" />
                </div>

                <span>Logística</span>

            </div>

        </div>

    </MudContainer>

</section>
