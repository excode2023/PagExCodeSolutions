
<section id="solution-paths"
         class="solution-paths-section"
         aria-labelledby="solution-paths-title">

    <div class="solution-paths-inner">

        @* SEO: Encabezado de los servicios *@
        <header class="section-heading">

            <span class="heading-decoration" aria-hidden="true">
                <span></span>
            </span>

            <p class="section-eyebrow">
                SOLUCIONES DIGITALES PARA TU NEGOCIO
            </p>

            <h2 id="solution-paths-title"
                class="section-title">
                <span class="title-line title-line--primary">
                    Software a medida y
                </span>

                <span class="title-line title-line--accent">
                    soluciones digitales
                </span>
            </h2>

            <p class="section-description">
                <span>Descubre cómo podemos ayudarte con</span>
                <span>desarrollo de software empresarial, aplicaciones web,</span>
                <span>automatización de procesos, inteligencia artificial y MicroApps.</span>
            </p>

        </header>

        <MudGrid Spacing="4" Class="solution-grid">

            @* =========================================
               01 - AUTOMATIZACIÓN DE PROCESOS
               ========================================= *@

            <MudItem xs="12" sm="6" lg="3">

                <a href="/soluciones"
                   class="solution-card-link"
                   aria-label="Explorar soluciones de automatización de procesos empresariales">

                    <MudCard Class="solution-card solution-card--point"
                             Elevation="0">

                        <div class="solution-media">

                            <img src="/images/categories/problem-puntual.webp"
                                 alt="Profesional gestionando documentos y procesos empresariales que pueden automatizarse"
                                 width="1600"
                                 height="900"
                                 loading="lazy" />

                            <span class="icon-badge"
                                  aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.TipsAndUpdates" />
                            </span>

                        </div>

                        <MudCardContent Class="solution-card-content">

                            <span class="card-number"
                                  aria-hidden="true">01</span>

                            <h3 class="card-title">
                                Resolver un problema puntual
                            </h3>

                            <p class="card-description">
                                Automatiza tareas repetitivas,
                                optimiza procesos empresariales
                                y desarrolla funcionalidades
                                específicas sin reemplazar
                                todo tu sistema.
                            </p>

                            <span class="card-action">
                                Explorar soluciones

                                <span class="arrow-icon"
                                      aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                </span>
                            </span>

                        </MudCardContent>

                    </MudCard>
                </a>

            </MudItem>

            @* =========================================
               02 - SOFTWARE EMPRESARIAL A MEDIDA
               ========================================= *@

            <MudItem xs="12" sm="6" lg="3">

                <a href="/sistemas"
                   class="solution-card-link"
                   aria-label="Explorar desarrollo de software empresarial y sistemas a medida">

                    <MudCard Class="solution-card solution-card--system"
                             Elevation="0">

                        <div class="solution-media">

                            <img src="/images/categories/sistema-completo.webp"
                                 alt="Equipo empresarial analizando datos y sistemas de gestión"
                                 width="1600"
                                 height="900"
                                 loading="lazy" />

                            <span class="icon-badge"
                                  aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.DashboardCustomize" />
                            </span>

                        </div>

                        <MudCardContent Class="solution-card-content">

                            <span class="card-number"
                                  aria-hidden="true">02</span>

                            <h3 class="card-title">
                                Desarrollar un sistema completo
                            </h3>

                            <p class="card-description">
                                Desarrollamos software a medida,
                                aplicaciones web y sistemas
                                empresariales para gestionar
                                procesos, usuarios y datos
                                de forma eficiente.
                            </p>

                            <span class="card-action">
                                Explorar sistemas

                                <span class="arrow-icon"
                                      aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                </span>
                            </span>

                        </MudCardContent>

                    </MudCard>
                </a>

            </MudItem>

            @* =========================================
               03 - INTELIGENCIA ARTIFICIAL
               ========================================= *@

            <MudItem xs="12" sm="6" lg="3">

                <a href="/soluciones-ia"
                   class="solution-card-link"
                   aria-label="Explorar soluciones con inteligencia artificial, agentes de IA y chatbots">

                    <MudCard Class="solution-card solution-card--ai"
                             Elevation="0">

                        <div class="solution-media">

                            <img src="/images/categories/soluciones-ia.webp"
                                 alt="Profesional utilizando herramientas de inteligencia artificial para automatización empresarial"
                                 width="1600"
                                 height="900"
                                 loading="lazy" />

                            <span class="icon-badge"
                                  aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Psychology" />
                            </span>

                        </div>

                        <MudCardContent Class="solution-card-content">

                            <span class="card-number"
                                  aria-hidden="true">03</span>

                            <h3 class="card-title">
                                Explorar soluciones con IA
                            </h3>

                            <p class="card-description">
                                Exploramos soluciones con
                                inteligencia artificial,
                                agentes de IA, chatbots y
                                automatización inteligente
                                para necesidades concretas.
                            </p>

                            <span class="card-action">
                                Explorar posibilidades

                                <span class="arrow-icon"
                                      aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                </span>
                            </span>

                        </MudCardContent>

                    </MudCard>
                </a>

            </MudItem>

            @* =========================================
               04 - MICROAPPS
               ========================================= *@

            <MudItem xs="12" sm="6" lg="3">

                <a href="/micro-apps"
                   class="solution-card-link"
                   aria-label="Explorar MicroApps para presupuestos, reservas, inventarios y automatización de tareas">

                    <MudCard Class="solution-card solution-card--micro"
                             Elevation="0">

                        <div class="solution-media">

                            <img src="/images/categories/micro-apps.webp"
                                 alt="MicroApps para organizar tareas, presupuestos e inventarios"
                                 width="1600"
                                 height="900"
                                 loading="lazy" />

                            <span class="icon-badge"
                                  aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Apps" />
                            </span>

                        </div>

                        <MudCardContent Class="solution-card-content">

                            <span class="card-number"
                                  aria-hidden="true">04</span>

                            <h3 class="card-title">
                                Micro apps para tener más control
                            </h3>

                            <p class="card-description">
                                Pequeñas aplicaciones digitales
                                para crear presupuestos, gestionar
                                reservas, controlar inventarios
                                y automatizar tareas personales
                                o de tu negocio.
                            </p>

                            <span class="card-action">
                                Explorar micro apps

                                <span class="arrow-icon"
                                      aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                </span>
                            </span>

                        </MudCardContent>

                    </MudCard>
                </a>

            </MudItem>

        </MudGrid>

    </div>

</section>
