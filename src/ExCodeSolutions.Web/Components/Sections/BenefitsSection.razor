<section class="benefits-section"
         aria-label="Beneficios principales">

    <MudContainer MaxWidth="MaxWidth.Large">

        <MudGrid Spacing="0" Class="benefits-grid">

            <MudItem xs="12" sm="6" md="3">
                <div class="benefit-item">
                    <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Class="benefit-icon" />
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="benefit-title">Soluciones a medida</MudText>
                        <MudText Typo="Typo.body2" Class="benefit-description">Para cada tipo de empresa</MudText>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="benefit-item">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="benefit-icon" />
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="benefit-title">Procesos automatizados</MudText>
                        <MudText Typo="Typo.body2" Class="benefit-description">Menos tareas manuales</MudText>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="benefit-item">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Class="benefit-icon" />
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="benefit-title">Integración de IA</MudText>
                        <MudText Typo="Typo.body2" Class="benefit-description">Decisiones más inteligentes</MudText>
                    </div>
                </div>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <div class="benefit-item benefit-item-last">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Class="benefit-icon" />
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="benefit-title">Acompañamiento real</MudText>
                        <MudText Typo="Typo.body2" Class="benefit-description">Desde el análisis hasta la puesta en marcha</MudText>
                    </div>
                </div>
            </MudItem>

        </MudGrid>

    </MudContainer>

</section>
