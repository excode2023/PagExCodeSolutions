@inherits LayoutComponentBase

@* Servicios visuales *@
<MudThemeProvider Theme="@ExCodeTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Estructura principal *@

<MudLayout>
    @* Navegación principal *@
    <NavMenu />
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@* Mensaje de error *@
<div id="blazor-error-ui"
     data-nosnippet>

    An unexpected error has occurred.

    <a href="."
       class="reload">
        Reload
    </a>

    <span class="dismiss">
        🗙
    </span>
</div>
