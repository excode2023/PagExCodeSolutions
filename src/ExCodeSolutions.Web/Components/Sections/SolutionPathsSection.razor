<section id="solution-paths"
         class="solution-paths-section"
         aria-labelledby="solution-paths-title">

    <div class="solution-paths-inner">
        <header class="section-heading">
            <p class="section-eyebrow">¿QUÉ NECESITA TU EMPRESA?</p>

            <h2 id="solution-paths-title" class="section-title">
                Encuentra la <span>solución ideal</span> para ti
            </h2>

            <p class="section-description">
                Selecciona el tipo de apoyo que mejor representa tu necesidad.
                Te orientamos desde el primer análisis.
            </p>
        </header>

        <MudGrid Spacing="4" Class="solution-grid">
            <MudItem xs="12" sm="6" lg="3">
                <a href="/soluciones"
                   class="solution-card-link"
                   aria-label="Explorar soluciones para resolver un problema puntual">

                    <MudCard Class="solution-card solution-card--point" Elevation="0">
                        <div class="solution-media">
                            <img src="/images/categories/problem-puntual.webp"
                                 alt="Profesional gestionando numerosos documentos y procesos manuales"
                                 width="1600"
                                 height="900"
                                 loading="lazy" />

                            <span class="icon-badge" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.TipsAndUpdates" />
                            </span>
                        </div>

                        <MudCardContent Class="solution-card-content">
                            <span class="card-number" aria-hidden="true">01</span>

                            <h3 class="card-title">Resolver un problema puntual</h3>

                            <p class="card-description">
                                Automatiza una tarea, mejora un proceso o incorpora una
                                funcionalidad específica sin reconstruir todo tu sistema.
                            </p>

                            <span class="card-action">
                                Explorar soluciones
                                <span class="arrow-icon" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                </span>
                            </span>
                        </MudCardContent>
                    </MudCard>
                </a>
            </MudItem>

            <MudItem xs="12" sm="6" lg="3">
                <a href="/sistemas"
                   class="solution-card-link"
                   aria-label="Explorar el desarrollo de sistemas completos">

                    <MudCard Class="solution-card solution-card--system" Elevation="0">
                        <div class="solution-media">
                            <img src="/images/categories/sistema-completo.webp"
                                 alt="Equipo empresarial analizando dashboards y datos operativos"
                                 width="1600"
                                 height="900"
                                 loading="lazy" />

                            <span class="icon-badge" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.DashboardCustomize" />
                            </span>
                        </div>

                        <MudCardContent Class="solution-card-content">
                            <span class="card-number" aria-hidden="true">02</span>

                            <h3 class="card-title">Desarrollar un sistema completo</h3>

                            <p class="card-description">
                                Diseñamos una solución conectada y escalable según tus
                                procesos, usuarios, datos y objetivos comerciales.
                            </p>

                            <span class="card-action">
                                Explorar sistemas
                                <span class="arrow-icon" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                </span>
                            </span>
                        </MudCardContent>
                    </MudCard>
                </a>
            </MudItem>

            <MudItem xs="12" sm="6" lg="3">
                <a href="/soluciones-ia"
                   class="solution-card-link"
                   aria-label="Explorar soluciones empresariales con inteligencia artificial">

                    <MudCard Class="solution-card solution-card--ai" Elevation="0">
                        <div class="solution-media">
                            <img src="/images/categories/soluciones-ia.webp"
                                 alt="Profesional utilizando automatización e inteligencia artificial"
                                 width="1600"
                                 height="900"
                                 loading="lazy" />

                            <span class="icon-badge" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Psychology" />
                            </span>
                        </div>

                        <MudCardContent Class="solution-card-content">
                            <span class="card-number" aria-hidden="true">03</span>

                            <h3 class="card-title">Explorar soluciones con IA</h3>

                            <p class="card-description">
                                Evaluamos asistentes y automatizaciones inteligentes cuando
                                puedan producir un beneficio real y medible.
                            </p>

                            <span class="card-action">
                                Explorar posibilidades
                                <span class="arrow-icon" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                </span>
                            </span>
                        </MudCardContent>
                    </MudCard>
                </a>
            </MudItem>

            <MudItem xs="12" sm="6" lg="3">
                <a href="/micro-apps"
                   class="solution-card-link"
                   aria-label="Explorar micro apps para organizar tareas concretas">

                    <MudCard Class="solution-card solution-card--micro" Elevation="0">
                        <div class="solution-media">
                            <img src="/images/categories/micro-apps.webp"
                                 alt="Micro apps para organizar tareas de un negocio y del día a día"
                                 width="1600"
                                 height="900"
                                 loading="lazy" />

                            <span class="icon-badge" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.Apps" />
                            </span>
                        </div>

                        <MudCardContent Class="solution-card-content">
                            <span class="card-number" aria-hidden="true">04</span>

                            <h3 class="card-title">Micro apps para tener más control</h3>

                            <p class="card-description">
                                Herramientas digitales sencillas para organizar tareas como
                                gastos, pedidos, inventario o citas, tanto para tu negocio
                                como para tu día a día.
                            </p>

                            <span class="card-action">
                                Explorar micro apps
                                <span class="arrow-icon" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                                </span>
                            </span>
                        </MudCardContent>
                    </MudCard>
                </a>
            </MudItem>
        </MudGrid>
    </div>
</section>
