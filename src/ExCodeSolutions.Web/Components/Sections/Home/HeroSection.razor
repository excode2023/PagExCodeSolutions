@inject ISnackbar Snackbar

<section class="hero-section" aria-labelledby="hero-title">
    <div class="hero-overlay" aria-hidden="true"></div>

    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="hero-container">
        <div class="hero-content">
            <div class="badge-pill">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" />
                <span>Software · Automatización · IA para empresas</span>
            </div>

            <MudText id="hero-title" Typo="Typo.h1" Class="hero-title">
                Transformamos tus procesos en
                <span class="hero-highlight">soluciones digitales reales</span>
            </MudText>

            <MudText Typo="Typo.body1" Class="hero-description">
                Diseñamos software a medida, automatizamos tareas e integramos
                tecnología para que tu empresa trabaje mejor, con claridad y sin
                complicaciones.
            </MudText>

            <div class="hero-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           EndIcon="@Icons.Material.Filled.ArrowForward" Class="hero-btn"
                           OnClick="ShowContactMessage">
                    Cuéntanos tu proyecto
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           Class="hero-btn hero-btn-outline" OnClick="ShowSolutionsMessage">
                    Ver nuestras soluciones
                </MudButton>
            </div>
        </div>

        @* Elementos decorativos: se mantienen lejos del texto principal. *@
        <div class="hero-cards" aria-hidden="true">
            <div class="floating-card card-ia">
                <MudIcon Icon="@Icons.Material.Filled.Psychology" />
                <span>IA</span>
            </div>
            <div class="floating-card card-chatbot">
                <MudIcon Icon="@Icons.Material.Filled.Chat" />
                <span>Chatbot WhatsApp</span>
            </div>
            <div class="floating-card card-citas">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
                <span>Citas</span>
            </div>
            <div class="floating-card card-logistica">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" />
                <span>Logística</span>
            </div>
        </div>
    </MudContainer>
</section>

@code {
    private void ShowContactMessage() =>
        Snackbar.Add("El módulo de contacto estará disponible próximamente.", Severity.Info);

    private void ShowSolutionsMessage() =>
        Snackbar.Add("La sección de soluciones estará disponible próximamente.", Severity.Info);
}
