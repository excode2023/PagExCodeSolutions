<footer class="site-footer">

    @* Franja de llamada a la acción que aparece sobre el pie principal. *@
    <div class="footer-cta-area">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">

            <section class="project-cta"
                     aria-labelledby="footer-cta-title">

                <div class="project-cta-message">
                    <span class="project-cta-icon" aria-hidden="true">
                        <svg viewBox="0 0 64 64" focusable="false">
                            <circle cx="30" cy="34" r="20"></circle>
                            <circle cx="30" cy="34" r="11"></circle>
                            <circle cx="30" cy="34" r="3"></circle>
                            <path d="M31 33 49 15"></path>
                            <path d="M43 15h7v7"></path>
                        </svg>
                    </span>

                    <span class="project-cta-divider" aria-hidden="true"></span>

                    <div class="project-cta-copy">
                        <h2 id="footer-cta-title">
                            ¿Tienes un proyecto en mente?
                        </h2>

                        <p>
                            Cuéntanos tu idea y te asesoramos sin compromiso.
                        </p>
                    </div>
                </div>

                <a class="project-cta-button" href="/#contact">
                    <span>Hablemos de tu proyecto</span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                             aria-hidden="true" />
                </a>

            </section>

        </MudContainer>
    </div>

    @* Contenido principal del pie de página. *@
    <div class="footer-main">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">

            <div class="footer-content">

                <div class="footer-brand-column">
                    <a class="footer-brand"
                       href="/"
                       aria-label="Ir al inicio de Ex-code Solutions">

                        <svg class="footer-brand-mark"
                             viewBox="0 0 64 64"
                             aria-hidden="true"
                             focusable="false">
                            <defs>
                                <linearGradient id="footer-logo-gradient"
                                                x1="0" y1="0" x2="1" y2="1">
                                    <stop offset="0" stop-color="#21b8ff"></stop>
                                    <stop offset="1" stop-color="#0875ed"></stop>
                                </linearGradient>
                            </defs>
                            <rect x="7" y="7" width="17" height="50" rx="8.5"
                                  fill="url(#footer-logo-gradient)"></rect>
                            <rect x="17" y="7" width="40" height="12" rx="6"
                                  fill="url(#footer-logo-gradient)"></rect>
                            <rect x="17" y="26" width="31" height="12" rx="6"
                                  fill="url(#footer-logo-gradient)"></rect>
                            <rect x="17" y="45" width="40" height="12" rx="6"
                                  fill="url(#footer-logo-gradient)"></rect>
                        </svg>

                        <span class="footer-brand-copy">
                            <strong>Ex-code Solutions</strong>
                            <span>Building Software That Moves Business Forward</span>
                        </span>
                    </a>
                </div>

                <nav class="footer-column"
                     aria-labelledby="footer-links-title">
                    <h2 id="footer-links-title">Enlaces</h2>

                    <ul class="footer-link-list">
                        <li><a href="/">Inicio</a></li>
                        <li><a href="/soluciones">Soluciones</a></li>
                        <li><a href="/#projects">Proyectos</a></li>
                        <li><a href="/#process">Cómo trabajamos</a></li>
                    </ul>
                </nav>

                <nav class="footer-column"
                     aria-labelledby="footer-services-title">
                    <h2 id="footer-services-title">Servicios</h2>

                    <ul class="footer-link-list">
                        <li><a href="/sistemas">Software a medida</a></li>
                        <li><a href="/sistemas">Páginas web</a></li>
                        <li><a href="/sistemas">Aplicaciones empresariales</a></li>
                        <li><a href="/soluciones-ia">Inteligencia artificial</a></li>
                    </ul>
                </nav>

                <div class="footer-column footer-contact"
                     aria-labelledby="footer-contact-title">
                    <h2 id="footer-contact-title">Contacto</h2>

                    <ul class="footer-contact-list">
                        <li>
                            <MudIcon Icon="@Icons.Material.Outlined.Email"
                                     aria-hidden="true" />
                            <a href="mailto:info@ex-codesolutions.com">
                                info@ex-codesolutions.com
                            </a>
                        </li>

                        <li>
                            <MudIcon Icon="@Icons.Material.Outlined.LocationOn"
                                     aria-hidden="true" />
                            <span>Países Bajos / Europa</span>
                        </li>

                        <li>
                            <MudIcon Icon="@Icons.Material.Outlined.Forum"
                                     aria-hidden="true" />
                            <a class="contact-highlight" href="/#contact">
                                Contacto
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="footer-social-column"
                     aria-label="Redes sociales de Ex-code Solutions">

                    @* TODO: sustituir cada URL por el perfil oficial de Ex-code Solutions. *@
                    <a class="social-link"
                       href="https://www.linkedin.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="LinkedIn de Ex-code Solutions">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M6.5 8.4H3.2V19H6.5V8.4ZM4.85 3A1.9 1.9 0 1 0 4.85 6.8 1.9 1.9 0 0 0 4.85 3ZM20.8 13.1C20.8 9.9 19.1 8.1 16.5 8.1A3.7 3.7 0 0 0 13.2 9.9V8.4H10V19H13.3V13.7C13.3 12.3 13.6 10.9 15.4 10.9 17.2 10.9 17.2 12.6 17.2 13.8V19H20.5L20.8 13.1Z"></path>
                        </svg>
                    </a>

                    <a class="social-link"
                       href="https://www.instagram.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Instagram de Ex-code Solutions">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5"></rect>
                            <circle cx="12" cy="12" r="4.1"></circle>
                            <circle class="social-icon-dot" cx="17.7" cy="6.5" r="1"></circle>
                        </svg>
                    </a>

                    <a class="social-link"
                       href="https://www.youtube.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="YouTube de Ex-code Solutions">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M21 8.1A3 3 0 0 0 18.9 6C17.1 5.5 12 5.5 12 5.5S6.9 5.5 5.1 6A3 3 0 0 0 3 8.1 31 31 0 0 0 2.6 12 31 31 0 0 0 3 15.9 3 3 0 0 0 5.1 18C6.9 18.5 12 18.5 12 18.5S17.1 18.5 18.9 18A3 3 0 0 0 21 15.9 31 31 0 0 0 21.4 12 31 31 0 0 0 21 8.1Z"></path>
                            <path class="social-icon-play" d="m10 9 5 3-5 3Z"></path>
                        </svg>
                    </a>

                    <a class="social-link"
                       href="https://www.facebook.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Facebook de Ex-code Solutions">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M14.4 21V13.2H17L17.4 10.2H14.4V8.3C14.4 7.4 14.7 6.8 15.9 6.8H17.5V4.1C17.2 4.1 16.3 4 15.2 4 12.9 4 11.4 5.4 11.4 8V10.2H8.8V13.2H11.4V21H14.4Z"></path>
                        </svg>
                    </a>

                </div>

            </div>

            <div class="footer-bottom">
                <p>© @CurrentYear Ex-code Solutions</p>
                <a href="/privacidad">Privacidad</a>
            </div>

        </MudContainer>
    </div>

</footer>

@code {
    private int CurrentYear => DateTime.Now.Year;
}
